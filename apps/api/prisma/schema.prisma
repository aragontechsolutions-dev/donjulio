// ─────────────────────────────────────────────────────────────────────────
// Don Julio — Esquema de datos (Prisma + PostgreSQL / Supabase)
// Modela las tres capas: catálogo/CMS público, back-office de gestión
// (stock, BOM multinivel, producción, mermas, caja, salón/KDS) y fiscal (CFE).
// ─────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Conexión de la app: en Supabase, usar el pooler (pgbouncer, puerto 6543).
  url       = env("DATABASE_URL")
  // Conexión directa (puerto 5432) para migraciones. En local puede ser igual
  // a DATABASE_URL; en Supabase apunta al host directo sin pgbouncer.
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserRole {
  ADMIN
  CAJERO
  PRODUCCION
  MOZO
  DELIVERY
}

enum UnitOfMeasure {
  G
  KG
  ML
  L
  UNIDAD
  DOCENA
}

enum IvaRate {
  EXENTO
  MINIMA // 10%
  BASICA // 22%
}

/// Cómo se cobra un producto en el mostrador: por unidad o por peso.
enum UnidadVenta {
  UNIDAD
  KG
}

enum OrderChannel {
  WEB
  APP_CLIENTE
  MOSTRADOR
  TELEFONO
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  CARRITO
  PENDIENTE_PAGO
  PAGADO
  EN_PREPARACION
  LISTO
  EN_CAMINO
  LISTO_PARA_RETIRO
  ENTREGADO
  RECHAZADO
  CANCELADO
}

enum OrderItemStatus {
  PENDIENTE
  EN_PREPARACION
  LISTO
  ENTREGADO
  CANCELADO
}

enum PaymentMethod {
  EFECTIVO
  DEBITO
  CREDITO
  MERCADO_PAGO_QR
  MERCADO_PAGO_CHECKOUT
  TRANSFERENCIA
  ABITAB
  REDPAGOS
}

enum PaymentStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
  REEMBOLSADO
  CANCELADO
}

enum CfeType {
  E_TICKET // 101
  E_TICKET_NC // 102
  E_FACTURA // 111
  E_FACTURA_NC // 112
}

enum CfeStatus {
  PENDIENTE
  EMITIDO
  RECHAZADO
  ANULADO
}

enum StockMovementType {
  ENTRADA
  SALIDA
  AJUSTE
  MERMA
}

enum ProductionOrderStatus {
  PLANIFICADA
  EN_PROCESO
  TERMINADA
  CANCELADA
}

enum MermaMotivo {
  NO_VENDIDO
  ROTURA
  VENCIMIENTO
  CONSUMO_PERSONAL
  OTRO
}

enum TableStatus {
  LIBRE
  OCUPADA
  RESERVADA
  PENDIENTE_PAGO
}

enum StationType {
  PANADERIA
  REPOSTERIA
  COCINA
  BARRA
}

enum CashSessionStatus {
  ABIERTA
  CERRADA
}

enum CashMovementType {
  SALE
  IN
  OUT
  WITHDRAWAL
  EXPENSE
}

enum CustomOrderStatus {
  RESERVADO
  EN_PRODUCCION
  LISTO
  ENTREGADO
  CANCELADO
}

enum ReservaStatus {
  PENDIENTE
  CONFIRMADA
  SENTADA
  CANCELADA
  NO_SHOW
}

enum PromoTipoDescuento {
  PORCENTAJE
  MONTO_FIJO
  PRECIO_FIJO
}

// ──────────────────────── Usuarios y clientes ────────────────────────

/// Estado de un cobro enviado a la terminal de tarjetas (Point Smart).
enum EstadoCobroTerminal {
  PENDIENTE
  ENVIADO
  APROBADO
  RECHAZADO
  CANCELADO
  EXPIRADO
  ERROR
}

model Usuario {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String
  nombre           String
  role             UserRole  @default(CAJERO)
  activo           Boolean   @default(true)
  /// Intentos de login fallidos seguidos. Vuelve a cero al entrar bien.
  intentosFallidos Int       @default(0)
  /// Cuándo se bloqueó por errar la contraseña de más. Null = no bloqueada.
  /// Sólo un admin la desbloquea: no se destraba sola con el tiempo, porque
  /// en un local la persona tiene a quién pedírselo y un desbloqueo
  /// automático le devolvería los intentos a quien esté probando claves.
  bloqueadaEn      DateTime?
  // Fichaje en el tablet del local: número correlativo + PIN de 4 dígitos.
  numeroEmpleado   Int       @unique @default(autoincrement())
  pinHash          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relaciones operativas
  movimientosStock  MovimientoStock[]
  ordenesProduccion OrdenProduccion[]
  mermas            Merma[]
  pedidosComoMozo   Pedido[]           @relation("PedidoMozo")
  eventosPedido     OrderStatusEvent[]
  cajasAbiertas     CashSession[]      @relation("CajaAbiertaPor")
  cajasCerradas     CashSession[]      @relation("CajaCerradaPor")
  movimientosCaja   CashMovement[]
  turnos            Shift[]
  horarios          HorarioTrabajo[]
  propinas          Propina[]
  cobrosTerminal    CobroTerminal[]
}

model Cliente {
  id                  String    @id @default(uuid())
  nombre              String
  telefono            String?
  email               String?
  direccion           String?
  // Ley 18.331 (URCDP): consentimiento informado del titular.
  consentimientoDatos Boolean   @default(false)
  consentimientoAt    DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  pedidos      Pedido[]
  customOrders CustomOrder[]

  @@index([telefono])
  @@index([email])
}

// ─────────────────────── Catálogo y menú ───────────────────────

model Categoria {
  id        String   @id @default(uuid())
  nombre    String
  slug      String   @unique
  orden     Int      @default(0)
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())

  productos   Producto[]
  promociones Promocion[]
  /// Proveedores a los que se les compra este rubro.
  proveedores Proveedor[]
}

model Producto {
  id               String      @id @default(uuid())
  categoriaId      String
  categoria        Categoria   @relation(fields: [categoriaId], references: [id])
  nombre           String
  slug             String      @unique
  descripcion      String?
  precio           Decimal     @db.Decimal(12, 2)
  imagenUrl        String?
  destacado        Boolean     @default(false)
  disponible       Boolean     @default(true)
  ivaRate          IvaRate     @default(MINIMA)
  esReventa        Boolean     @default(false) // reventa (embotellados) vs elaborado
  /// Cuánto cuesta comprarlo, sólo para productos de reventa. Los elaborados
  /// sacan su costo de la receta asociada.
  costoCompra      Decimal?    @db.Decimal(12, 4)
  /// Si se vende de lo producido: la venta descuenta de los lotes y se bloquea
  /// cuando no hay stock. Para lo que se prepara al momento (café, tostados)
  /// va en false, que es como se comportaba todo hasta ahora.
  controlaStock    Boolean     @default(false)
  /// Cómo se cobra en el mostrador. Con KG, `precio` es el precio por kilo y
  /// lo que se vende es el peso que marcó la balanza.
  unidadVenta      UnidadVenta @default(UNIDAD)
  /// A quién se le compra (sobre todo en la reventa). Uno principal: si se
  /// compra a varios, el resto se anota en las notas del proveedor.
  proveedorId      String?
  proveedor        Proveedor?  @relation(fields: [proveedorId], references: [id])
  requiereOctogono Boolean     @default(false) // Decreto 272/018 (rotulado frontal)
  stationId        String?
  station          Station?    @relation(fields: [stationId], references: [id])
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  receta          Receta?
  rotulado        RotuladoProducto?
  variantes       ProductVariant[]
  modifierGroups  ProductModifierGroup[]
  promociones     Promocion[]
  itemsPedido     PedidoItem[]
  lotesProduccion ProductionLot[]
  mermas          Merma[]

  @@index([categoriaId])
  @@index([destacado])
  @@index([proveedorId])
}

model ProductVariant {
  id          String   @id @default(uuid())
  productoId  String
  producto    Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  nombre      String // ej. "Grande", "500 g"
  precioDelta Decimal  @default(0) @db.Decimal(12, 2)

  itemsPedido PedidoItem[]

  @@index([productoId])
}

model ModifierGroup {
  id        String @id @default(uuid())
  nombre    String // ej. "Tipo de leche"
  minSelect Int    @default(0)
  maxSelect Int    @default(1)

  modifiers Modifier[]
  productos ProductModifierGroup[]
}

model Modifier {
  id         String        @id @default(uuid())
  groupId    String
  group      ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  nombre     String // ej. "Leche vegetal"
  priceDelta Decimal       @default(0) @db.Decimal(12, 2)
  insumoId   String?
  insumo     Insumo?       @relation(fields: [insumoId], references: [id])

  itemsPedido PedidoItemModifier[]

  @@index([groupId])
}

model ProductModifierGroup {
  productoId String
  producto   Producto      @relation(fields: [productoId], references: [id], onDelete: Cascade)
  groupId    String
  group      ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([productoId, groupId])
  @@index([groupId])
}

model Promocion {
  id            String             @id @default(uuid())
  nombre        String
  descripcion   String?
  productoId    String?
  producto      Producto?          @relation(fields: [productoId], references: [id])
  categoriaId   String?
  categoria     Categoria?         @relation(fields: [categoriaId], references: [id])
  tipoDescuento PromoTipoDescuento
  valor         Decimal            @db.Decimal(12, 2) // % o monto según tipo
  vigenciaDesde DateTime
  vigenciaHasta DateTime
  activa        Boolean            @default(true)
  createdAt     DateTime           @default(now())

  @@index([activa, vigenciaDesde, vigenciaHasta])
}

// ─────────────────────── CMS ligero de la landing ───────────────────────

model ContenidoLanding {
  id        String   @id @default(uuid())
  clave     String   @unique // ej. "hero.titulo", "historia.texto"
  valor     String
  updatedAt DateTime @updatedAt
}

model Galeria {
  id        String  @id @default(uuid())
  imagenUrl String
  titulo    String?
  orden     Int     @default(0)
  activa    Boolean @default(true)
}

model Testimonio {
  id       String  @id @default(uuid())
  autor    String
  texto    String
  rating   Int     @default(5)
  aprobado Boolean @default(false)
  orden    Int     @default(0)
}

model Horario {
  id        String  @id @default(uuid())
  diaSemana Int // 0=domingo … 6=sábado
  apertura  String // "07:00"
  cierre    String // "20:00"
  cerrado   Boolean @default(false)

  @@unique([diaSemana])
}

model ConfigContacto {
  id        String   @id @default(uuid())
  direccion String?
  telefono  String?
  whatsapp  String?
  email     String?
  instagram String?
  facebook  String?
  mapsUrl   String?
  lat       Float?
  lng       Float?
  /// Nivel de zoom con el que se muestra el mapa público (1 = mundo, 19 = calle).
  mapZoom   Int?
  updatedAt DateTime @updatedAt
}

// ─────────────────── Insumos, proveedores y stock ───────────────────

model Proveedor {
  id        String   @id @default(uuid())
  nombre    String
  /// RUT: es lo que identifica al proveedor en la factura de compra.
  rut       String?
  /// Persona con la que se habla, que no siempre es el nombre de la empresa.
  contacto  String?
  telefono  String?
  email     String?
  direccion String?
  /// Días de reparto, condiciones de pago, lo que haga falta recordar.
  notas     String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  // Con default a nivel de base: la tabla ya tenía filas cuando se agregó
  // la columna, y sin default la migración no podía aplicarse.
  updatedAt DateTime @default(now()) @updatedAt

  /// Rubros que se le compran. Se declaran aparte de los productos porque un
  /// proveedor nuevo se carga antes de saber qué artículos se le van a pedir.
  categorias Categoria[]
  /// Lo que efectivamente se le compra.
  insumos    Insumo[]
  productos  Producto[]
}

model Insumo {
  id            String        @id @default(uuid())
  nombre        String
  unidad        UnitOfMeasure
  costoUnitario Decimal       @db.Decimal(12, 4)
  stockActual   Decimal       @default(0) @db.Decimal(12, 3)
  puntoReorden  Decimal       @default(0) @db.Decimal(12, 3)
  proveedorId   String?
  proveedor     Proveedor?    @relation(fields: [proveedorId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  lotes              InsumoLote[]
  movimientos        MovimientoStock[]
  recetaIngredientes RecetaIngrediente[]
  modifiers          Modifier[]
  mermas             Merma[]

  @@index([proveedorId])
}

model InsumoLote {
  id            String    @id @default(uuid())
  insumoId      String
  insumo        Insumo    @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  lote          String
  cantidad      Decimal   @db.Decimal(12, 3)
  vencimiento   DateTime?
  costoUnitario Decimal   @db.Decimal(12, 4)
  recibidoAt    DateTime  @default(now())

  movimientos MovimientoStock[]

  @@index([insumoId])
  @@index([vencimiento])
}

model MovimientoStock {
  id                String            @id @default(uuid())
  insumoId          String
  insumo            Insumo            @relation(fields: [insumoId], references: [id])
  tipo              StockMovementType
  cantidad          Decimal           @db.Decimal(12, 3)
  costoUnitario     Decimal           @default(0) @db.Decimal(12, 4)
  motivo            String?
  // Lote de insumo consumido/ingresado (trazabilidad).
  insumoLoteId      String?
  insumoLote        InsumoLote?       @relation(fields: [insumoLoteId], references: [id])
  ordenProduccionId String?
  ordenProduccion   OrdenProduccion?  @relation(fields: [ordenProduccionId], references: [id])
  usuarioId         String?
  usuario           Usuario?          @relation(fields: [usuarioId], references: [id])
  createdAt         DateTime          @default(now())

  @@index([insumoId])
  @@index([insumoLoteId])
  @@index([ordenProduccionId])
  @@index([createdAt])
}

// ─────────────── Recetas / BOM multinivel (sub-recetas) ───────────────

model Receta {
  id            String        @id @default(uuid())
  nombre        String
  // Un producto terminado tiene una receta; las sub-recetas no tienen producto.
  productoId    String?       @unique
  producto      Producto?     @relation(fields: [productoId], references: [id])
  isSubRecipe   Boolean       @default(false)
  yieldQty      Decimal       @default(1) @db.Decimal(12, 3) // rendimiento del lote
  yieldUnit     UnitOfMeasure @default(UNIDAD)
  mermaPct      Decimal       @default(0) @db.Decimal(5, 2) // % de merma esperada
  manoObraCosto Decimal       @default(0) @db.Decimal(12, 2)
  overheadCosto Decimal       @default(0) @db.Decimal(12, 2)
  notas         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // BOM: ingredientes de esta receta (insumos o sub-recetas)
  ingredientes RecetaIngrediente[] @relation("RecetaParent")
  // Dónde se usa esta receta como sub-receta de otra
  usadaEn      RecetaIngrediente[] @relation("SubReceta")
  ordenes      OrdenProduccion[]
}

/// Línea del BOM. Referencia un Insumo O una sub-Receta (self-relation),
/// permitiendo recetas multinivel con costeo recursivo.
model RecetaIngrediente {
  id          String        @id @default(uuid())
  recetaId    String
  receta      Receta        @relation("RecetaParent", fields: [recetaId], references: [id], onDelete: Cascade)
  insumoId    String?
  insumo      Insumo?       @relation(fields: [insumoId], references: [id])
  subRecetaId String?
  subReceta   Receta?       @relation("SubReceta", fields: [subRecetaId], references: [id])
  cantidad    Decimal       @db.Decimal(12, 3)
  unidad      UnitOfMeasure

  @@index([recetaId])
  @@index([insumoId])
  @@index([subRecetaId])
}

model OrdenProduccion {
  id              String                @id @default(uuid())
  recetaId        String
  receta          Receta                @relation(fields: [recetaId], references: [id])
  cantidadLotes   Decimal               @default(1) @db.Decimal(12, 3)
  status          ProductionOrderStatus @default(PLANIFICADA)
  planificadaPara DateTime?
  iniciadaAt      DateTime?
  terminadaAt     DateTime?
  usuarioId       String?
  usuario         Usuario?              @relation(fields: [usuarioId], references: [id])
  createdAt       DateTime              @default(now())

  movimientos MovimientoStock[]
  lotes       ProductionLot[]

  @@index([recetaId])
  @@index([status])
}

model ProductionLot {
  id                String           @id @default(uuid())
  ordenProduccionId String?
  ordenProduccion   OrdenProduccion? @relation(fields: [ordenProduccionId], references: [id])
  productoId        String?
  producto          Producto?        @relation(fields: [productoId], references: [id])
  lote              String
  qty               Decimal          @db.Decimal(12, 3)
  producedAt        DateTime         @default(now())
  expiresAt         DateTime?

  mermas Merma[]

  @@index([productoId])
  @@index([expiresAt])
}

model Merma {
  id              String         @id @default(uuid())
  productoId      String?
  producto        Producto?      @relation(fields: [productoId], references: [id])
  insumoId        String?
  insumo          Insumo?        @relation(fields: [insumoId], references: [id])
  productionLotId String?
  productionLot   ProductionLot? @relation(fields: [productionLotId], references: [id])
  motivo          MermaMotivo
  cantidad        Decimal        @db.Decimal(12, 3)
  costo           Decimal        @default(0) @db.Decimal(12, 2)
  usuarioId       String?
  usuario         Usuario?       @relation(fields: [usuarioId], references: [id])
  createdAt       DateTime       @default(now())

  @@index([createdAt])
}

// ─────────────────────── Salón / mesas / KDS ───────────────────────

model Station {
  id     String      @id @default(uuid())
  nombre String
  tipo   StationType

  productos Producto[]
  items     PedidoItem[]
}

model Zona {
  id     String @id @default(uuid())
  nombre String

  mesas Mesa[]
}

model Mesa {
  id           String      @id @default(uuid())
  numero       Int
  zonaId       String?
  zona         Zona?       @relation(fields: [zonaId], references: [id])
  capacidad    Int         @default(4)
  status       TableStatus @default(LIBRE)
  // Posición y forma en el plano del salón (editor visual).
  posX         Int         @default(20)
  posY         Int         @default(20)
  forma        String      @default("CUADRADA") // CUADRADA | CIRCULAR
  qrToken      String      @unique @default(uuid()) // token para el autoservicio por mesa (QR/tablet)
  pideCuentaAt DateTime? // el cliente pidió la cuenta desde el autoservicio (se limpia al cobrar)

  pedidos  Pedido[]
  sillas   Silla[]
  reservas Reserva[]

  @@unique([numero])
  @@index([zonaId])
}

/// Silla/comensal de una mesa: posición propia y nombre del cliente sentado.
model Silla {
  id     String  @id @default(uuid())
  mesaId String
  mesa   Mesa    @relation(fields: [mesaId], references: [id], onDelete: Cascade)
  numero Int // orden de la silla dentro de la mesa (1..capacidad)
  nombre String? // nombre/etiqueta del cliente sentado
  // Posición como offset respecto al centro de la mesa (el editor las arrastra).
  posX   Int     @default(0)
  posY   Int     @default(0)

  items PedidoItem[]

  @@index([mesaId])
}

// ─────────────────────── Pedidos y ventas ───────────────────────

model Pedido {
  id             String       @id @default(uuid())
  numero         Int          @unique @default(autoincrement())
  channel        OrderChannel
  orderType      OrderType
  status         OrderStatus  @default(CARRITO)
  clienteId      String?
  cliente        Cliente?     @relation(fields: [clienteId], references: [id])
  mesaId         String?
  mesa           Mesa?        @relation(fields: [mesaId], references: [id])
  mozoId         String?
  mozo           Usuario?     @relation("PedidoMozo", fields: [mozoId], references: [id])
  subtotal       Decimal      @default(0) @db.Decimal(12, 2)
  descuento      Decimal      @default(0) @db.Decimal(12, 2)
  total          Decimal      @default(0) @db.Decimal(12, 2)
  // Desglose de IVA, abierto por tasa como lo pide el comprobante fiscal.
  // Los precios se cargan con IVA incluido: esto es lo que sale de adentro
  // del total, no algo que se le sume.
  neto           Decimal      @default(0) @db.Decimal(12, 2)
  ivaTotal       Decimal      @default(0) @db.Decimal(12, 2)
  netoIvaMinima  Decimal      @default(0) @db.Decimal(12, 2)
  ivaMinima      Decimal      @default(0) @db.Decimal(12, 2)
  netoIvaBasica  Decimal      @default(0) @db.Decimal(12, 2)
  ivaBasica      Decimal      @default(0) @db.Decimal(12, 2)
  montoNoGravado Decimal      @default(0) @db.Decimal(12, 2)
  notas          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items           PedidoItem[]
  pagos           Payment[]
  eventos         OrderStatusEvent[]
  comprobantes    Comprobante[]
  propinas        Propina[]
  movimientosCaja CashMovement[]
  cobroTerminal   CobroTerminal?

  @@index([status])
  @@index([clienteId])
  @@index([mesaId])
  @@index([createdAt])
}

model PedidoItem {
  id               String          @id @default(uuid())
  pedidoId         String
  pedido           Pedido          @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  productoId       String
  producto         Producto        @relation(fields: [productoId], references: [id])
  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])
  stationId        String?
  station          Station?        @relation(fields: [stationId], references: [id])
  /// Decimal porque el mostrador vende por balanza: 0,350 son 350 g. En los
  /// productos por unidad sigue siendo un entero.
  cantidad         Decimal         @db.Decimal(12, 3)
  /// Por unidad, o por kilo en lo que se vende pesado.
  precioUnitario   Decimal         @db.Decimal(12, 2)
  subtotal         Decimal         @db.Decimal(12, 2)
  // Tasa y montos congelados al momento de vender: si mañana cambia la tasa
  // del producto, la venta de ayer tiene que seguir mostrando lo que se cobró.
  ivaRate          IvaRate         @default(MINIMA)
  neto             Decimal         @default(0) @db.Decimal(12, 2)
  ivaMonto         Decimal         @default(0) @db.Decimal(12, 2)
  notas            String?
  status           OrderItemStatus @default(PENDIENTE)
  // Comensal (silla) al que se le imputa el ítem, para cuentas individuales.
  sillaId          String?
  silla            Silla?          @relation(fields: [sillaId], references: [id])
  pagado           Boolean         @default(false) // marcado al cobrar parcial por comensal

  modificadores PedidoItemModifier[]

  @@index([pedidoId])
  @@index([productoId])
  @@index([stationId])
  @@index([sillaId])
}

model PedidoItemModifier {
  id           String     @id @default(uuid())
  pedidoItemId String
  pedidoItem   PedidoItem @relation(fields: [pedidoItemId], references: [id], onDelete: Cascade)
  modifierId   String
  modifier     Modifier   @relation(fields: [modifierId], references: [id])
  nombre       String
  priceDelta   Decimal    @default(0) @db.Decimal(12, 2)

  @@index([pedidoItemId])
}

/// Auditoría de transiciones de estado de un pedido.
model OrderStatusEvent {
  id        String       @id @default(uuid())
  pedidoId  String
  pedido    Pedido       @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  fromState OrderStatus?
  toState   OrderStatus
  usuarioId String?
  usuario   Usuario?     @relation(fields: [usuarioId], references: [id])
  createdAt DateTime     @default(now())

  @@index([pedidoId])
}

model Payment {
  id             String        @id @default(uuid())
  pedidoId       String
  pedido         Pedido        @relation(fields: [pedidoId], references: [id])
  metodo         PaymentMethod
  monto          Decimal       @db.Decimal(12, 2)
  status         PaymentStatus @default(PENDIENTE)
  provider       String? // "mock" | "mercadopago"
  mpPaymentId    String?
  idempotencyKey String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  propinas Propina[]

  @@index([pedidoId])
  @@index([status])
}

/// Idempotencia de webhooks (Mercado Pago, CFE). Rechaza duplicados.
model WebhookEvent {
  id        String   @id @default(uuid())
  provider  String
  eventId   String
  tipo      String?
  payload   Json
  procesado Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([provider, eventId])
}

/// Propina registrada (para distribución interna). El aporte BPS es ficto (3 BFC).
model Propina {
  id        String   @id @default(uuid())
  pedidoId  String?
  pedido    Pedido?  @relation(fields: [pedidoId], references: [id])
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id])
  mozoId    String?
  mozo      Usuario? @relation(fields: [mozoId], references: [id])
  monto     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
}

// ─────────────────────── Caja / turnos ───────────────────────

model CashSession {
  id            String            @id @default(uuid())
  openedById    String
  openedBy      Usuario           @relation("CajaAbiertaPor", fields: [openedById], references: [id])
  closedById    String?
  closedBy      Usuario?          @relation("CajaCerradaPor", fields: [closedById], references: [id])
  etiqueta      String? // ej. "Caja 1 - turno mañana"
  openingFloat  Decimal           @default(0) @db.Decimal(12, 2)
  closingCount  Decimal?          @db.Decimal(12, 2)
  expected      Decimal?          @db.Decimal(12, 2)
  difference    Decimal?          @db.Decimal(12, 2)
  justificacion String? // motivo del descuadre cuando supera la tolerancia
  status        CashSessionStatus @default(ABIERTA)
  openedAt      DateTime          @default(now())
  closedAt      DateTime?

  movimientos    CashMovement[]
  cobrosTerminal CobroTerminal[]

  @@index([status])
  @@index([openedById])
}

model CashMovement {
  id            String           @id @default(uuid())
  cashSessionId String
  cashSession   CashSession      @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  tipo          CashMovementType
  metodoPago    PaymentMethod?
  monto         Decimal          @db.Decimal(12, 2)
  referencia    String?
  /// Venta que originó el movimiento: sin esto, de una línea de caja no se
  /// puede saber qué se vendió (la referencia es sólo un texto).
  pedidoId      String?
  pedido        Pedido?          @relation(fields: [pedidoId], references: [id])
  usuarioId     String?
  usuario       Usuario?         @relation(fields: [usuarioId], references: [id])
  createdAt     DateTime         @default(now())

  @@index([cashSessionId])
  @@index([pedidoId])
}

model Shift {
  id             String    @id @default(uuid())
  usuarioId      String
  usuario        Usuario   @relation(fields: [usuarioId], references: [id])
  inicio         DateTime  @default(now())
  fin            DateTime?
  /// Comparación con el horario previsto (minutos; null = sin horario cargado).
  minutosTarde   Int?
  minutosAntes   Int?
  horarioInicio  String?
  horarioFin     String?
  /// Foto tomada por el tablet al marcar (evidencia de quién fichó).
  fotoEntradaUrl String?
  fotoSalidaUrl  String?
  /// Permiso de un solo uso para subir la foto de la marca recién hecha.
  /// Formato "entrada:<uuid>" o "salida:<uuid>": dice a qué campo va.
  fotoToken      String?   @unique
  fotoTokenExp   DateTime?

  @@index([usuarioId])
}

// ─────────────────────── Encargos (pedidos a medida) ───────────────────────

model CustomOrder {
  id          String            @id @default(uuid())
  clienteId   String?
  cliente     Cliente?          @relation(fields: [clienteId], references: [id])
  descripcion String
  specs       Json? // sabor, relleno, porciones, tema, colores, texto…
  porciones   Int?
  pickupAt    DateTime
  precioTotal Decimal           @default(0) @db.Decimal(12, 2)
  senia       Decimal           @default(0) @db.Decimal(12, 2)
  saldo       Decimal           @default(0) @db.Decimal(12, 2)
  status      CustomOrderStatus @default(RESERVADO)
  notas       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  depositos Deposito[]

  @@index([status])
  @@index([pickupAt])
}

model Deposito {
  id            String        @id @default(uuid())
  customOrderId String
  customOrder   CustomOrder   @relation(fields: [customOrderId], references: [id], onDelete: Cascade)
  monto         Decimal       @db.Decimal(12, 2)
  metodo        PaymentMethod
  createdAt     DateTime      @default(now())

  @@index([customOrderId])
}

// ─────────────────────── Fiscal / CFE (DGI) ───────────────────────

model Comprobante {
  id             String    @id @default(uuid())
  pedidoId       String?
  pedido         Pedido?   @relation(fields: [pedidoId], references: [id])
  tipo           CfeType
  serie          String?
  numero         Int?
  caeNumero      String?
  caeVencimiento DateTime?
  hash           String?
  xmlUrl         String?
  qrUrl          String?
  status         CfeStatus @default(PENDIENTE)
  rutReceptor    String?
  montoTotal     Decimal   @db.Decimal(12, 2)
  iva            Decimal   @default(0) @db.Decimal(12, 2)
  provider       String? // "mock" | "surtec" | "uruware"
  createdAt      DateTime  @default(now())

  @@index([pedidoId])
  @@index([status])
}

/// Plano del salón (singleton): imagen de fondo y tamaño del lienzo del editor.
model SalonPlano {
  id            String  @id @default("default")
  imagenUrl     String?
  ancho         Int     @default(900)
  alto          Int     @default(520)
  opacidad      Int     @default(100) // 0..100, opacidad de la imagen de fondo
  mostrarGrilla Boolean @default(true)

  areas AreaMesas[]
}

/// Área del salón donde se pueden ubicar mesas (los sectores del plano real).
model AreaMesas {
  id      String     @id @default(uuid())
  planoId String     @default("default")
  plano   SalonPlano @relation(fields: [planoId], references: [id], onDelete: Cascade)
  nombre  String     @default("Área")
  x       Int        @default(20)
  y       Int        @default(20)
  ancho   Int        @default(240)
  alto    Int        @default(180)

  @@index([planoId])
}

/// Rotulado frontal y ficha nutricional de un producto (Decreto 272/018 y modificativos).
/// Los valores nutricionales se declaran por 100 g (sólidos) o 100 ml (líquidos).
model RotuladoProducto {
  id         String   @id @default(uuid())
  productoId String   @unique
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  porcion      String? // ej. "1 unidad (60 g)"
  ingredientes String? // lista de ingredientes en orden decreciente
  alergenos    String? // ej. "Contiene gluten, leche, huevo"
  esLiquido    Boolean @default(false) // define los umbrales aplicables

  // Ficha nutricional por 100 g / 100 ml
  energiaKcal     Decimal? @db.Decimal(10, 2)
  proteinas       Decimal? @db.Decimal(10, 2)
  carbohidratos   Decimal? @db.Decimal(10, 2)
  azucares        Decimal? @db.Decimal(10, 2)
  grasasTotales   Decimal? @db.Decimal(10, 2)
  grasasSaturadas Decimal? @db.Decimal(10, 2)
  grasasTrans     Decimal? @db.Decimal(10, 2)
  fibra           Decimal? @db.Decimal(10, 2)
  sodioMg         Decimal? @db.Decimal(10, 2)

  // Sellos frontales. Se sugieren desde los valores, pero pueden fijarse a mano.
  autoOctogonos        Boolean @default(true)
  excesoAzucares       Boolean @default(false)
  excesoSodio          Boolean @default(false)
  excesoGrasas         Boolean @default(false)
  excesoGrasasSat      Boolean @default(false)
  // Leyendas precautorias
  contieneEdulcorantes Boolean @default(false)
  contieneCafeina      Boolean @default(false)

  updatedAt DateTime @updatedAt
}

/// Reserva de mesa (por teléfono, web o mostrador).
model Reserva {
  id        String        @id @default(uuid())
  mesaId    String?
  mesa      Mesa?         @relation(fields: [mesaId], references: [id])
  nombre    String
  telefono  String?
  personas  Int           @default(2)
  fechaHora DateTime
  status    ReservaStatus @default(PENDIENTE)
  notas     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([fechaHora])
  @@index([status])
  @@index([mesaId])
}

/// Tablet de fichaje del local (singleton): token del enlace, dispositivo
/// autorizado y tolerancia de horario.
model KioscoFichaje {
  id               String    @id @default("default")
  token            String    @unique @default(uuid())
  /// Identificador del único tablet autorizado a fichar (null = ninguno).
  deviceId         String?
  deviceNombre     String?
  deviceUltimoUso  DateTime?
  /// Ventana para vincular un tablet nuevo; vencida, no se acepta ninguno.
  vinculacionHasta DateTime?
  /// Minutos de gracia para llegadas tarde / salidas tempranas.
  toleranciaMin    Int       @default(10)
  /// Pedir foto al marcar. Se apaga si el tablet no tiene cámara.
  pedirFoto        Boolean   @default(true)
}

/// Horario semanal previsto de un trabajador (para detectar tarde/temprano).
model HorarioTrabajo {
  id         String  @id @default(uuid())
  usuarioId  String
  usuario    Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  diaSemana  Int // 0 = domingo … 6 = sábado
  horaInicio String // "08:00"
  horaFin    String // "16:00"

  @@unique([usuarioId, diaSemana])
  @@index([usuarioId])
}

/// Política de sesión por rol (singleton): minutos de inactividad antes de
/// cerrar sesión automáticamente. 0 = sin cierre automático.
model SesionConfig {
  id            String @id @default("default")
  adminMin      Int    @default(5)
  cajeroMin     Int    @default(30)
  produccionMin Int    @default(30)
  mozoMin       Int    @default(0)
  deliveryMin   Int    @default(0)
}

/// Cómo se liquida el IVA. Son definiciones del contador, no del código.
model FiscalConfig {
  id                    String   @id @default("default")
  /// Los precios de Productos ya incluyen IVA (venta a consumidor final).
  /// En false el sistema se lo sumaría encima al total.
  preciosConIvaIncluido Boolean  @default(true)
  /// Facturar todo el consumo en mesa como servicio gastronómico a tasa
  /// básica, sin importar la tasa de cada producto. Queda apagado: las
  /// fuentes públicas no coinciden en si una confitería debe hacerlo, así
  /// que lo prende el contador si corresponde.
  salonTasaBasica       Boolean  @default(false)
  updatedAt             DateTime @default(now()) @updatedAt
}

/// Un cobro con tarjeta enviado a la terminal (Mercado Pago Point).
///
/// Existe porque el cobro con posnet integrado no es instantáneo: el monto
/// viaja a la terminal y la respuesta llega después, por webhook o
/// consultando. Guardar el intento es lo que permite que la venta se registre
/// sola cuando Mercado Pago aprueba, aunque la cajera haya cerrado el
/// navegador, y que un cobro aprobado nunca quede sin su venta.
model CobroTerminal {
  id             String  @id @default(uuid())
  /// Terminal a la que se mandó (terminal_id de Mercado Pago).
  terminalId     String
  /// Id de la order/payment intent del lado de Mercado Pago.
  externalId     String? @unique
  /// Clave de idempotencia con la que se creó: reintentar no cobra dos veces.
  idempotencyKey String  @unique

  monto   Decimal             @db.Decimal(12, 2)
  metodo  PaymentMethod
  estado  EstadoCobroTerminal @default(PENDIENTE)
  /// Motivo del rechazo o del error, tal como lo informa el proveedor.
  detalle String?

  /// El carrito tal como estaba al mandar el cobro. Con esto la venta se
  /// arma del lado del servidor cuando llega la aprobación, sin depender de
  /// que el navegador de la cajera siga vivo.
  carrito     Json
  rutReceptor String?

  /// Venta generada al aprobarse. Nulo mientras no se cobró, y también en un
  /// cobro aprobado que todavía no pudo registrarse: eso es lo que se revisa.
  pedidoId String? @unique
  pedido   Pedido? @relation(fields: [pedidoId], references: [id])

  cashSessionId String
  cashSession   CashSession @relation(fields: [cashSessionId], references: [id])
  usuarioId     String
  usuario       Usuario     @relation(fields: [usuarioId], references: [id])

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resueltoEn DateTime?

  @@index([estado])
  @@index([cashSessionId])
  @@index([createdAt])
}
