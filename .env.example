# ─────────────────────────────────────────────────────────────
# Don Julio — Variables de entorno (copiar a .env)
# ─────────────────────────────────────────────────────────────

# --- Base de datos ---
# LOCAL (docker-compose): ambas iguales.
# SUPABASE: DATABASE_URL = pooler (pgbouncer, puerto 6543, con ?pgbouncer=true)
#           DIRECT_URL   = conexión directa (puerto 5432) para migraciones.
DATABASE_URL="postgresql://donjulio:donjulio@localhost:5432/donjulio?schema=public"
DIRECT_URL="postgresql://donjulio:donjulio@localhost:5432/donjulio?schema=public"

# --- API (NestJS) ---
API_PORT=3000
# Orígenes permitidos por CORS (separados por coma)
# 5173 = web (landing/panel), 5174 = PWA de mozos
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

# --- Auth ---
# AUTH_PROVIDER: "local" (JWT propio) | "supabase" (verifica el JWT de Supabase)
AUTH_PROVIDER="local"
# Secreto para firmar los JWT del panel (modo local). Cambiar en producción.
JWT_SECRET="cambiar-este-secreto-en-produccion"
JWT_EXPIRES_IN="12h"
# Modo supabase: "JWT Secret" del proyecto (Settings → API → JWT Settings, HS256).
SUPABASE_JWT_SECRET=""

# --- Supabase (activar cuando se tengan credenciales reales) ---
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Storage de imágenes ---
# STORAGE_PROVIDER: "local" (disco) | "supabase" (Supabase Storage)
STORAGE_PROVIDER="local"
SUPABASE_STORAGE_BUCKET="donjulio"

# --- Mercado Pago (mock por defecto) ---
# PAYMENTS_PROVIDER: "mock" | "mercadopago"
PAYMENTS_PROVIDER="mock"
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""

# --- Facturación electrónica CFE (mock por defecto) ---
# BILLING_PROVIDER: "mock" | "surtec" | "uruware"
BILLING_PROVIDER="mock"
CFE_API_BASE_URL=""
CFE_API_TOKEN=""
CFE_RUT_EMISOR=""

# --- Frontend (Vite) — prefijo VITE_ obligatorio ---
VITE_API_BASE_URL="http://localhost:3000/api"
# Auth del frontend: "local" o "supabase". En "supabase" el login usa supabase-js.
VITE_AUTH_PROVIDER="local"
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# --- PWA de mozos (apps/pwa-mozo) ---
# Debe apuntar a la misma API. En tablet, usar la IP del server (no localhost).
# Ej.: "http://192.168.1.50:3000/api"
